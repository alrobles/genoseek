#!/bin/bash
#SBATCH --job-name=genoseek_ingest_combine
#SBATCH --output=logs/ingest_combine_%j.out
#SBATCH --error=logs/ingest_combine_%j.err
#SBATCH --partition=sixhour
#SBATCH --account=kbs
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=06:00:00

set -euo pipefail

cd "${SLURM_SUBMIT_DIR}"

export PYTHONUNBUFFERED=1
export PYTHONDONTWRITEBYTECODE=1
export GENOSEEK_WORK="${GENOSEEK_WORK:-$HOME/work}"
export ENTREZ_KEY_FILE="${ENTREZ_KEY_FILE:-$GENOSEEK_WORK/../env/nih-entrez-key}"

export ENTREZ_API_KEY=$(python3 - <<'PY'
import os
p = os.environ.get("ENTREZ_KEY_FILE") or os.path.expanduser("~/env/nih-entrez-key")
if os.path.exists(p):
    raw = open(p).read().strip()
    if raw.startswith("ENTREZ_API_KEY="):
        print(raw.split("=", 1)[1])
    else:
        print(raw)
PY
)

echo "=== Ingesting SRA/BioSample metadata for top candidates ==="
python3 scripts/ingest_genetic_candidates.py \
    --candidates data/candidates.tsv \
    --top-n 20 \
    --min-sra 5 \
    --prefer-missing \
    --out data/genetic_ingest_report.tsv \
    --genetic-dir data/genetic \
    --max-runs 1000 \
    --coord-res-deg 0.25 \
    --sleep 0.4

echo "=== Looking up reference genomes for top candidates ==="
python3 scripts/ingest_reference_genomes.py \
    --candidates data/candidates.tsv \
    --top-n 20 \
    --out data/reference_genome_report.tsv \
    --sleep 0.5

echo "=== Combining reports into SPA-ready candidate table ==="
python3 scripts/combine_spa_ready_report.py \
    --candidates data/candidates.tsv \
    --genetic data/genetic_ingest_report.tsv \
    --references data/reference_genome_report.tsv \
    --genetic-dir data/genetic \
    --vcf-database data/vcf_database \
    --out data/spa_ready_candidates.tsv

echo "genoseek ingest/combine complete. Output: data/spa_ready_candidates.tsv"
