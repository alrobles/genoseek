#!/bin/bash
#SBATCH --job-name=genoseek_snapshot
#SBATCH --output=logs/snapshot_%j.out
#SBATCH --error=logs/snapshot_%j.err
#SBATCH --partition=sixhour
#SBATCH --account=kbs
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=4G
#SBATCH --time=00:30:00

set -euo pipefail

if [ -n "${SLURM_SUBMIT_DIR:-}" ]; then
    REPO_ROOT="${SLURM_SUBMIT_DIR}"
else
    REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

cd "${REPO_ROOT}"

export PYTHONUNBUFFERED=1
export GENOSEEK_WORK="${GENOSEEK_WORK:-$HOME/work}"
export GENOSEEK_SCRATCH="${GENOSEEK_SCRATCH:-$HOME/genoseek/scratch}"

echo "=== Archiving cycle outputs + diffing vs previous snapshot ==="
python3 scripts/snapshot_diff.py \
    --data-dir data \
    --snapshots-dir data/snapshots \
    --min-sra 5 \
    --vcf-manifest "$GENOSEEK_SCRATCH/publish/vcf_database/vcf_manifest.tsv"

echo "=== Progress report ==="
python3 scripts/progress_report.py \
    --db "$GENOSEEK_SCRATCH/publish/genoseek/genoseek.db" \
    --scratch "$GENOSEEK_SCRATCH" \
    --out-tsv "$GENOSEEK_SCRATCH/publish/progress.tsv" || true

echo "=== Snapshot cycle complete ==="
